import java.util.*;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int k = sc.nextInt();

        int[] a = new int[n];

        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }

        if (k > n) {
            System.out.println(-1);
            return;
        }

        Arrays.sort(a);

        System.out.println(a[n - k] + " 0");
    }
}
