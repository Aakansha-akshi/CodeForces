import java.util.*;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        String s = sc.next();

        s = s.toLowerCase();

        Set<Character> set = new HashSet<>();

        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            set.add(c);
        }

        if (set.size() == 26)
            System.out.println("YES");
        else
            System.out.println("NO");
    }
}
