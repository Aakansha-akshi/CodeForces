n = int(input())
rounds = []
scores = {}
for _ in range(n):
    name, score = input().split()
    score = int(score)
    rounds.append((name, score))
    scores[name] = scores.get(name, 0) + score
maximum = max(scores.values())
current = {}
for name, score in rounds:
    current[name] = current.get(name, 0) + score
    if current[name] >= maximum and scores[name] == maximum:
        print(name)
        break
